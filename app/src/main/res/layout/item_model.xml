<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="158dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:layout_marginVertical="6dp"
    android:checkable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/cerise"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconBackdrop"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/cerise"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/modelIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_model_robot" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/selectedDot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="invisible"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/modelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Modelo"
            android:textColor="@color/ink"
            android:textFontWeight="700"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/iconBackdrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/modelSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:minLines="2"
            android:text="Descrição"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/modelTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/animatedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/badge_animated"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/badge_animated"
            android:textColor="@color/white"
            android:textFontWeight="700"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/modelSubtitle"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
