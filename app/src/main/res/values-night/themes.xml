<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- CERISE theme (dark). -->
    <style name="Base.Theme.CeriseAR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cerise</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/cerise_dark</item>
        <item name="colorOnPrimaryContainer">@color/cerise_light</item>

        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/ink</item>

        <item name="colorTertiary">@color/orange</item>
        <item name="colorOnTertiary">@color/ink</item>

        <item name="android:colorBackground">@color/ink</item>
        <item name="colorSurface">@color/ink_soft</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/cerise_light</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="fontFamily">@font/work_sans</item>
        <item name="android:fontFamily">@font/work_sans</item>
    </style>
</resources>
