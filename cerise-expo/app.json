{
  "expo": {
    "name": "CERISE AR",
    "slug": "cerise-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cerisear",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://cerise.wenfur.com.br/updates/manifest",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.ufg.cerise.arviewer",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para a experiência em realidade aumentada do CERISE AR.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cerisear",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FCE7F1"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "@reactvision/react-viro"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
